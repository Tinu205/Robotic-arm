<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="orange">
    <color rgba="1 0.3 0.1 1"/>
  </material>
  <material name="blue">
    <color rgba ="0.2 0.2 1 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
  </link>

  <!-- chassis fixed box -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0.0 0 0.07"/>
  </joint>

  <link name="chassis_link">
    <visual>
      <geometry>
        <box size="0.5 0.5 0.14"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.5 0.14"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="14" x="0.5" y="0.5" z="0.14">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>
  
  <!-- Revolute arm rotates around z axis -->

  <joint name="base_yaw_joint" type="revolute">

    <parent link="chassis_link"/>
    <child link="base_yaw_link"/>

    <origin xyz="0 0 0.07" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>

    <limit lower="-1.57"
     upper="1.57"
     effort="60"
      velocity="1"/>

    <dynamics damping="0.3" friction="0.0"/>
  </joint>
  
  <link name="base_yaw_link">

    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.05"/>
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="0.25" length="0.08" radius="0.05">
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </xacro:inertial_cylinder>

  </link>


  <!--Shoulder joint use rhs refer .txt-->
  <joint name="shoulder_joint" type="revolute">

    <parent link="revolute_link"/>
    <child link="shoulder_link"/>

    <origin xyz="0 0 0.08" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>
    <limit lower="-1.57"
     upper="1.57"
     effort="60"
      velocity="1"/>

    <dynamics damping="0.3" friction="0.0"/>
  </joint>

  <link name="shoulder_link">

    <visual>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.9" radius="0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz = "0 0 0.45" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.9" radius="0.05"/>
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="2.8" length="0.9" radius="0.05">
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>


  <!--Elbow joint-->
  <joint name="elbow_joint" type="revolute">

    <parent link="shoulder_link"/>
    <child link="elbow_link"/>

    <origin xyz="0 0 0.9" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>
    <limit lower="-1.57"
     upper="1.57"
     effort="60"
      velocity="1"/>

    <dynamics damping="0.3" friction="0.0"/>
  </joint>

  <link name="elbow_link">

    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz = "0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.05"/>
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="1.3" length="0.4" radius="0.05">
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="tool_joint" type="fixed">

    <parent link="elbow_link"/>
    <child link="tool0"/>

    <origin xyz="0 0 0.4" rpy="0 0 0"/>

  </joint>

<link name="tool0"/>



</robot>
